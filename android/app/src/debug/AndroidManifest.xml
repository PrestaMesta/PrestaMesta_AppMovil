<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Cleartext (HTTP) traffic is only ever allowed in debug builds, so that
         `flutter run` can reach the local backend at http://10.0.2.2:<port>
         from the Android emulator. This attribute is merged only into debug
         builds — release/profile manifests do not set it, so a release APK
         cannot make cleartext requests regardless of what API_BASE_URL is
         configured with. Production is additionally enforced at the Dart
         level: EnvConfig rejects a non-https API_BASE_URL when APP_ENV=production. -->
    <application android:usesCleartextTraffic="true" tools:node="merge"/>
</manifest>
